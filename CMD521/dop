file_name = "apartments.svs"

apartments = []

try:

    f = open(file_name, "r", encoding="utf-8")

    for line in f:

        name, price = line.strip().split(";")

        apartments.append([name, int(price)])

    f.close()

except:

    pass

do = -1

while do != 0:

    do = int(input( " \n\n\n 1. Добавить квартиру \n 2. Удалить квартиру \n 3. Отредактировать квартиру \n 4. Показать все квартиры \n 5. Показать самую дешевую \n 6. Показать самую дорогую \n 7. От дешевой к дорогой \n 8. От дорогой к дешевой\n 0. Выход \n"))

    if do == 1:

        kv = str(input ("Введите название квартиры: "))

        zn = int(input ("Введите цену квартиры: "))

        apartments.append ([kv,zn])

        print (apartments)

    elif do == 2:

        kv = str(input ("Введите названия квартиры для удаления: "))

        found = False

        for item in apartments:

            if item[0] == kv:

                apartments.remove(item)

                found = True

                print(f"Квартира {kv} была удаленна")

                break

        if not found:

            print ("ТАкой квартиры нет")

            print (apartments)

    elif do == 3:

        target = input("Введите название для исправления: ")

        found = False

        for item in apartments:

            if item[0] == target:

                found = True

                ins = int(input("Что желаете поменять? \n 1.Цену \n 2.Название \n"))

                if ins == 1:

                    price = int(input("Введите новую цену: "))

                    item[1] = price

                    print("Цена измененна")

                elif ins == 2:

                    name = input("Введите новое название: ")

                    item[0] = name

                    print("НАзнавие измененно")

                break 

        if not found:

            print("Квартиры нет")

    elif do == 4:

        if not apartments:

            print("Список неверный")

        else:

            for item in apartments:

                print (f"{item[0]}:{item[1]}")

    elif do == 5:

        if not apartments:

            print("Список неверный")

        else:

            cheap = min(apartments, key=lambda x: x[1])

            print (f"Самая дешевая:{cheap[0]},{cheap[1]}")

    elif do == 6:

        if not apartments:

            print("Список неверный")

        else:

            cheap = max(apartments, key=lambda x: x[1])

            print (f"Самая дорогая:{cheap[0]},{cheap[1]}")

    elif do == 7:

        if not apartments:

            print("Список неверный")

        else:

            apartments.sort(key=lambda x: x[1])

            for item in apartments:

                print(f"{item[0]}:{item[1]}")

    elif do == 8:

        if not apartments:

            print("Список неверный")

        else:

            apartments.sort(key=lambda x: x[1], reverse=True)

            for item in apartments:

                print(f"{item[0]}:{item[1]}")

f = open(file_name, "w", encoding="utf-8")

for item in apartments:

    f.write(f"{item[0]};{item[1]}\n")

f.close()